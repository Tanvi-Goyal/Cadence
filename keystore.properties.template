# Copy to `keystore.properties` (gitignored) and fill in. Never commit the filled copy.
#
# storeFile is passed to rootProject.file(), so a RELATIVE path resolves against the repo root
# (`../keystores/x.jks` means AndroidStudioProjects/keystores, NOT ~/keystores). Use an absolute
# path — it is unambiguous, and the .jks belongs outside the repo so `git add -A` can never take it.
#
# Generate the upload key with:
#   keytool -genkeypair -v -keystore ~/keystores/mindset-upload.jks -storetype PKCS12 \
#     -alias mindset-upload -keyalg RSA -keysize 2048 -validity 10000
#
# PKCS12 requires keyPassword == storePassword; keytool will not let them differ.
#
# Do NOT quote the values. This is a java.util.Properties file, not shell: quotes are literal
# characters, so `storePassword="hunter2"` sets a 9-character password and signing fails with
# "keystore password was incorrect". Backslashes are escape characters here for the same reason.
#
storeFile=/absolute/path/to/keystores/mindset-upload.jks
storePassword=
keyAlias=mindset-upload
keyPassword=
