# Copy to `keystore.properties` (gitignored) and fill in. Never commit the filled copy.
# storeFile is resolved relative to the repo root; keep the actual .jks OUTSIDE the repo.
#
# Generate the upload key with:
#   keytool -genkeypair -v -keystore ~/keystores/mindset-upload.jks \
#     -alias mindset-upload -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../keystores/mindset-upload.jks
storePassword=
keyAlias=mindset-upload
keyPassword=
